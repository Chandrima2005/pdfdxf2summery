# Which LLM to use: heuristic (offline, no key) | openai (Gemini via OpenRouter, or any OpenAI-compatible endpoint)
LLM_PROVIDER=heuristic

# --- Any OpenAI-compatible endpoint (OpenAI, Groq, Together, Ollama...) ---
# OPENAI_API_KEY=...
# LLM_MODEL=<a model your endpoint serves, must support tool calling>
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Local Ollama example (no key needed; set OPENAI_API_KEY=ollama):
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_STRATEGY=structure
